html,body
  width: 100%
  height: 100%
  margin: 0
  padding: 0
.hill
  background: #eee
  cursor: pointer
  transition: order .35s ease-in-out
  width: 90px
.hill .id
  color: #f00
.hill.active
  background: #1b5
  color: #fff
  .id
    color: #fff
  box-shadow: 0 2px 4px rgba(0,0,0,.3)
svg
  width: 100%
  height: 100%
path
  fill: #eee
  stroke: #ccc
  stroke-width: 0.02
circle
  fill: #999
  fill-opacity: 0.3
  stroke: #777
  stroke-width: 0.02
  stroke-opacity: 0.5
circle.active
  fill: #f00
  fill-opacity: 0.5
  stroke: #d00
  stroke-width: 0.02

#hero
  height: 75vh
  .hero-text
    text-align: right
@media (max-width: 1024px)
  #hero
    height: auto
    .hero-text
      width: 100%
      padding: 1em
      text-align: center
    .hero-map
      width: 100%
